  </node>
  <node id="1004342" lat="52.5116000" lon="13.4010000">
    <tag k="railway" v="subway_entrance"/>
    <tag k="name" v="Spittelmarkt"/>
    <tag k="station" v="subway"/>
  </node>
  <node id="1004343" lat="52.5178000" lon="13.4065000">
    <tag k="railway" v="subway_entrance"/>
    <tag k="name" v="Rotes Rathaus"/>
    <tag k="station" v="subway"/>
  </node>
  <node id="1004344" lat="52.5227000" lon="13.4023000">
    <tag k="railway" v="station"/>
    <tag k="name" v="Hackescher Markt"/>
  </node>
  <node id="1004345" lat="52.5215000" lon="13.4110000">
    <tag k="railway" v="station"/>
    <tag k="name" v="Alexanderplatz"/>
  </node>
  <node id="1004346" lat="52.5162700" lon="13.3777000">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="Brandenburg Gate"/>
    <tag k="spreefall:card" v="brandenburg_gate"/>
    <tag k="spreefall:radius" v="55"/>
    <tag k="spreefall:text" v="Carl Gotthard Langhans finished this sandstone gate in 1791 as a city toll gate, and for twenty eight years after 1961 it stood walled off inside the death strip."/>
  </node>
  <node id="1004347" lat="52.5186100" lon="13.3761700">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="Reichstag"/>
    <tag k="spreefall:card" v="reichstag"/>
    <tag k="spreefall:radius" v="70"/>
    <tag k="spreefall:text" v="Burned in 1933, shelled to a shell in 1945 and given a walkable glass dome by Norman Foster in 1999, so that the public literally stands above the parliament."/>
  </node>
  <node id="1004348" lat="52.5139500" lon="13.3784300">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="Holocaust Memorial"/>
    <tag k="spreefall:card" v="memorial"/>
    <tag k="spreefall:radius" v="70"/>
    <tag k="spreefall:text" v="Peter Eisenman set 2711 concrete stelae on undulating ground in 2005. There is no prescribed path and no inscription, only the field."/>
  </node>
  <node id="1004349" lat="52.5168000" lon="13.3900000">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="Unter den Linden"/>
    <tag k="spreefall:card" v="unter_den_linden"/>
    <tag k="spreefall:radius" v="45"/>
    <tag k="spreefall:text" v="The lime tree avenue laid out in 1647 so the Elector could ride from his palace to the Tiergarten hunting ground without leaving the shade."/>
  </node>
  <node id="1004350" lat="52.5169000" lon="13.3939000">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="Bebelplatz"/>
    <tag k="spreefall:card" v="bebelplatz"/>
    <tag k="spreefall:radius" v="45"/>
    <tag k="spreefall:text" v="On 10 May 1933 students burned some twenty thousand books here. Micha Ullman sunk an empty white library under the square as the memorial."/>
  </node>
  <node id="1004351" lat="52.5135600" lon="13.3928100">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="Gendarmenmarkt"/>
    <tag k="spreefall:card" v="gendarmenmarkt"/>
    <tag k="spreefall:radius" v="55"/>
    <tag k="spreefall:text" v="Two matching cathedrals, French and German, flank Schinkel concert hall on what is widely called the most beautiful square in Berlin."/>
  </node>
  <node id="1004352" lat="52.5190700" lon="13.4009600">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="Berlin Cathedral"/>
    <tag k="spreefall:card" v="berliner_dom"/>
    <tag k="spreefall:radius" v="70"/>
    <tag k="spreefall:text" v="The Hohenzollern court church of 1905, its copper dome burnt out in 1944 and not fully restored until 1993."/>
  </node>
  <node id="1004353" lat="52.5202000" lon="13.3980000">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="Museum Island"/>
    <tag k="spreefall:card" v="museum_island"/>
    <tag k="spreefall:radius" v="70"/>
    <tag k="spreefall:text" v="Five museums built between 1830 and 1930 on a sandbank in the Spree, a UNESCO World Heritage Site since 1999."/>
  </node>
  <node id="1004354" lat="52.5208200" lon="13.4094200">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="Fernsehturm"/>
    <tag k="spreefall:card" v="tv_tower"/>
    <tag k="spreefall:radius" v="80"/>
    <tag k="spreefall:text" v="At 368 metres the tallest structure in Germany, opened in 1969. Berliners named the cross that sunlight throws on its sphere the Pope revenge."/>
  </node>
  <node id="1004355" lat="52.5096000" lon="13.3763000">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="Potsdamer Platz"/>
    <tag k="spreefall:card" v="potsdamer_platz"/>
    <tag k="spreefall:radius" v="70"/>
    <tag k="spreefall:text" v="Europe busiest intersection in the 1920s, a minefield after 1961, and a brand new quarter of towers after 1993."/>
  </node>
  <node id="1004356" lat="52.5208600" lon="13.3800000">
    <tag k="tourism" v="attraction"/>
    <tag k="name" v="The Spree"/>
    <tag k="spreefall:card" v="spree"/>
    <tag k="spreefall:radius" v="55"/>
    <tag k="spreefall:text" v="The river the city was founded on, running 400 kilometres from Lusatia to the Havel and moving so slowly it sometimes flows backwards."/>
  </node>
