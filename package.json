{
  "name": "spreefall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A walkable first person reconstruction of central Berlin in raw WebGL2, with no engine and no 3D library.",
  "scripts": {
    "fetch": "node tools/fetch-osm.mjs",
    "world": "node tools/build-world.mjs",
    "world:all": "node tools/fetch-osm.mjs --all && node tools/build-world.mjs --all",
    "world:offline": "node tools/fetch-osm.mjs --all --offline && node tools/build-world.mjs --all",
    "world:full": "node --max-old-space-size=12000 tools/fetch-osm.mjs --all --profile=full && node --max-old-space-size=12000 tools/build-world.mjs --all --profile=full",
    "test": "node --test tools/test/*.test.mjs",
    "build": "node tools/build-dist.mjs",
    "serve": "node tools/serve.mjs",
    "verify": "node tools/verify.mjs",
    "weigh": "node tools/weigh-city.mjs",
    "fit": "node tools/fit-city.mjs",
    "test:ui": "node tools/test-ui.mjs",
    "test:combat": "node tools/test-combat.mjs",
    "test:arsenal": "node tools/test-arsenal.mjs",
    "test:cheats": "node tools/test-cheats.mjs",
    "test:city": "node tools/test-city.mjs",
    "test:districts": "node tools/test-districts.mjs",
    "test:machines": "node tools/test-machines.mjs",
    "clip": "node tools/capture-walk.mjs",
    "all": "npm run world && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
